# Copie este arquivo para ".env" e preencha. NUNCA commite o ".env".
# (o hook gitleaks do pre-commit também barra segredos antes do commit)

# Produção (obrigatória)
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.regiao.aws.neon.tech/neondb?sslmode=require

# Desenvolvimento (opcional): use uma BRANCH do Neon para testar sem tocar na produção.
# Com ela definida, scripts/gerar_profile_dbt.py usa "dev" como target padrão local.
# DATABASE_URL_DEV=postgresql://usuario:senha@ep-yyyyy.regiao.aws.neon.tech/neondb?sslmode=require

# Testes de integração (opcional): banco DESCARTÁVEL; o nome precisa conter "test".
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/economia_test?sslmode=disable
