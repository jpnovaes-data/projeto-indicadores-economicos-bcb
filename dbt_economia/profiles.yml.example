# Este arquivo NAO vai para o Git. Ele fica em ~/.dbt/profiles.yml no seu PC
# (fora da pasta do projeto), que e o local padrao onde o dbt procura por ele.
#
# No Windows, o caminho normalmente e:
#   C:\Users\SEU_USUARIO\.dbt\profiles.yml
#
# Preencha host, user, password e dbname com os dados da sua connection
# string do Neon (a mesma usada no .env).

dbt_economia:
  target: dev
  outputs:
    dev:
      type: postgres
      host: SEU_HOST_NEON.neon.tech
      user: SEU_USUARIO
      password: SUA_SENHA
      port: 5432
      dbname: neondb
      schema: raw
      sslmode: require
      threads: 4
